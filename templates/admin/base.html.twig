{% extends '@Forumify/admin/base.html.twig' %}
{% block body %}
<link rel="stylesheet" href="{{ asset('bundles/forumifyidcardplugin/card.css') }}">
<section class="id-workspace">
    <header class="id-heading"><div><span class="id-eyebrow">SPEARHEAD / PERSONNEL SERVICES</span><h1>Identification Cards</h1></div><span class="id-tag">MILSIM ONLY</span></header>
    <nav class="id-nav" aria-label="Identification cards">
    {% for label, entry in {'Cards': ['id_cards_list','id_cards.view'], 'Create Card': ['id_cards_create','id_cards.create'], 'Unit Mapping': ['id_cards_mappings','id_card_configuration.unit_mapping'], 'Settings': ['id_cards_settings','id_card_configuration.manage']} %}
    {% if is_granted('id-cards.admin.' ~ entry[1]) %}<a href="{{ path(entry[0]) }}">{{ label }}</a>{% endif %}
    {% endfor %}
    </nav>
    {% for kind, messages in app.flashes %}{% for message in messages %}<p class="id-notice">{{ message }}</p>{% endfor %}{% endfor %}
    {% block card_body %}{% endblock %}
</section>
<script type="module" src="{{ asset('bundles/forumifyidcardplugin/card.js') }}"></script>
{% endblock %}
