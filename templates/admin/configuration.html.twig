{% extends '@ForumifyIdCardPlugin/admin/base.html.twig' %}
{% block card_body %}<h2>{{ title }}</h2><div class="id-detail"><section class="id-panel">{{ form_start(form) }}{{ form_widget(form) }}<button class="id-primary">Save</button>{{ form_end(form) }}<p class="id-muted">The permanent “MILSIM / TRAINING · NOT A GOVERNMENT ID” footer always appears on exported cards.</p></section>
{% if mappings is not null %}<section class="id-panel"><h3>Saved mappings</h3>{% for mapping in mappings %}<article><h4>{{ mapping.milhqUnitName }} (#{{ mapping.milhqUnitId }})</h4><p>{{ mapping.organizationLine1 }} / {{ mapping.organizationLine2 }} / {{ mapping.organizationLine3 }}</p><a href="{{ path('id_cards_mappings',{edit:mapping.id}) }}">Edit {{ mapping.enabled ? '' : '(disabled)' }}</a><form method="post" action="{{ path('id_cards_mapping_delete',{id:mapping.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('mapping_' ~ mapping.id) }}"><button>Delete mapping</button></form></article>{% else %}<p>No mappings yet.</p>{% endfor %}</section>{% endif %}</div>{% endblock %}
