{% extends '@ForumifyIdCardPlugin/admin/base.html.twig' %}
{% block card_body %}
<form class="id-filters" method="get"><input aria-label="Search cards" name="q" value="{{ filters.q }}" placeholder="Search name or Member ID"><select name="source" aria-label="Source"><option value="">All sources</option>{% for s in commandNetAvailable ? ['manual','milhq','commandnet'] : ['manual','milhq'] %}<option {{ filters.source == s ? 'selected' }}>{{ s }}</option>{% endfor %}</select><select name="status" aria-label="Status"><option value="">All statuses</option>{% for s in ['active','expired','revoked'] %}<option {{ filters.status == s ? 'selected' }}>{{ s }}</option>{% endfor %}</select><button>Filter</button></form>
<div class="id-table"><table><thead><tr>{% for title in ['Photo','Name','Member ID','Source','Unit','Issued','Expires','Status','Actions'] %}<th>{{ title }}</th>{% endfor %}</tr></thead><tbody>
{% for card in cards %}<tr><td>{% if photos.url(card) %}<img class="id-avatar" src="{{ photos.url(card) }}" alt="">{% else %}—{% endif %}</td><td>{{ card.displayName }}</td><td>{{ card.memberId }}</td><td>{{ card.source|upper }}</td><td>{{ card.organizationLine3 }}</td><td>{{ card.issueDate|date('Y-m-d') }}</td><td>{{ card.expirationDate|date('Y-m-d') }}</td><td><span class="id-status {{ statuses.resolve(card) }}">{{ statuses.resolve(card)|upper }}</span></td><td><a href="{{ path('id_cards_view',{id:card.id}) }}">View / actions</a>{% if is_granted('id-cards.admin.id_cards.manage') %} · <a href="{{ path('id_cards_edit',{id:card.id}) }}">Edit</a>{% endif %}{% if is_granted('id-cards.admin.id_cards.download') %} · <a href="{{ path('id_cards_download',{id:card.id}) }}">Download</a>{% endif %}</td></tr>
{% else %}<tr><td colspan="9">No cards found. Create a card to get started.</td></tr>{% endfor %}
</tbody></table></div><div class="id-actions">{% if page > 1 %}<a href="{{ path('id_cards_list',filters|merge({page:page-1})) }}">Previous</a>{% endif %}<span>Page {{ page }} · {{ total }} cards</span>{% if page*20 < total %}<a href="{{ path('id_cards_list',filters|merge({page:page+1})) }}">Next</a>{% endif %}</div>
{% endblock %}
