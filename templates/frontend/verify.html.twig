<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Member verification · {{ data.header }}</title><link rel="stylesheet" href="{{ asset('bundles/forumifyidcardplugin/card.css') }}"></head><body class="id-public"><main class="id-verification"><span class="id-eyebrow">{{ data.header }}</span><h1>Identification verification</h1><span class="id-status {{ data.status }}">{{ data.status|upper }}</span>{% if data.photo %}<img class="id-portrait" src="{{ data.photo }}" alt="Member portrait">{% endif %}<h2>{{ data.name }}</h2>{% for line in data.organization %}<p>{{ line }}</p>{% endfor %}
{% set serviceBits = [] %}
{% if data.rank %}{% set serviceBits = serviceBits|merge([data.rank]) %}{% endif %}
{% if data.specialty %}{% set serviceBits = serviceBits|merge([data.specialty]) %}{% endif %}
{% if data.callsign %}{% set serviceBits = serviceBits|merge(['"' ~ data.callsign ~ '"']) %}{% endif %}
{% if serviceBits is not empty %}<p class="id-service-line">{{ serviceBits|join(' · ') }}</p>{% endif %}
<dl><dt>Member ID</dt><dd>{{ data.memberId }}</dd><dt>Issued</dt><dd>{{ data.issue|date('F j, Y') }}</dd><dt>Expires</dt><dd>{{ data.expiration|date('F j, Y') }}</dd></dl>
{% if data.qualifications is not empty %}<div class="id-quals"><h3>Qualifications</h3><ul>{% for q in data.qualifications %}<li>{{ q.name }}{% if q.tier %} <span class="id-tier">{{ q.tier }}</span>{% endif %}</li>{% endfor %}</ul></div>{% endif %}
{% if data.awards is not empty %}<div class="id-awards"><h3>Awards</h3><ul>{% for a in data.awards %}<li>{{ a.name }}</li>{% endfor %}</ul></div>{% endif %}
<p class="id-notice">MILSIM / TRAINING · NOT A GOVERNMENT ID</p></main></body></html>
